# Supabase — mesmo projeto do painel.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública: a vitrine só lê dados publicados, protegidos por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta: ignora RLS para gravar o pedido no checkout e atualizá-lo pelo
# webhook. server-only — nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o painel, que o usa para pedir revalidação.
REVALIDATE_SECRET=

# Origens do painel autorizadas a comandar o destaque de blocos quando a loja
# roda dentro do iframe da prévia do editor de layout (separadas por vírgula).
# Lista vazia = nenhuma mensagem aceita; nunca use "*".
NEXT_PUBLIC_EDITOR_ORIGINS=http://localhost:3000,https://triomax-admin.vercel.app

# Mercado Pago — Checkout Transparente. Access Token é server-only (secreto);
# a Public Key vai ao navegador para tokenizar o cartão.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Segredo do webhook (painel do Mercado Pago) para validar a assinatura das
# notificações. Sem ele o webhook ainda funciona: o status é sempre reconsultado
# na API, então uma notificação forjada não consegue marcar um pedido como pago.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook. Se definida, vai em cada pagamento (notification_url)
# e dispensa configurar a URL no painel do Mercado Pago.
MERCADOPAGO_NOTIFICATION_URL=

# Melhor Envio — cotação de frete. Token pessoal, server-only (secreto).
MELHORENVIO_TOKEN=
# true = ambiente de teste (sandbox). Vazio ou false = produção.
MELHORENVIO_SANDBOX=false
# CEP de origem das encomendas (obrigatório) e contato exigido no User-Agent.
MELHORENVIO_FROM_CEP=
MELHORENVIO_USER_AGENT_EMAIL=
# Embalagem: medidas da caixa (cm), quantos produtos cabem nela e o peso de
# cada produto (kg). O frete divide o pedido em caixas: 6 produtos = 2 caixas.
MELHORENVIO_BOX_HEIGHT=20
MELHORENVIO_BOX_WIDTH=20
MELHORENVIO_BOX_LENGTH=20
MELHORENVIO_CAIXA_CAPACIDADE=3
MELHORENVIO_PESO_PRODUTO=1

# Motoboy (plataforma Entregas Expressas, praça Sr Express) — entrega no mesmo
# dia. Opcional: sem MOTOBOY_TOKEN/MOTOBOY_CLIENTE_ID a opção nunca aparece no
# checkout e o resto do frete segue igual.
MOTOBOY_TOKEN=
# Id do lojista dentro da praça. O token é da transportadora e enxerga vários
# lojistas — sem este id o pedido nasceria na conta errada.
MOTOBOY_CLIENTE_ID=
# false desliga a integração sem apagar as credenciais.
MOTOBOY_ATIVO=true
# Tipo de veículo e categoria da carga, conferidos em GET /tipos-veiculos e
# /tipos-veiculos/{id}/categorias. 1 = Moto, 9 = Produtos.
MOTOBOY_TIPO_VEICULO_ID=1
MOTOBOY_CATEGORIA_ID=9
# UFs atendidas (separadas por vírgula) e teto de distância em km. O teto existe
# porque a praça cota o estado inteiro: 98 km saem por R$ 219, o que não é opção
# de frete, é ruído na lista.
MOTOBOY_UFS=SC
MOTOBOY_MAX_KM=30
# Peso máximo que cabe na moto (kg) — acima disso a opção não aparece.
MOTOBOY_PESO_MAXIMO_KG=30
# "faturado" (a praça cobra depois) ou "carteira" (debita saldo pré-pago).
MOTOBOY_METODO_PAGAMENTO=faturado
# Como o pedido nasce no painel da praça. "preparing" = a loja ainda embala e o
# entregador só é acionado quando alguém libera lá. "pending" chama motoboy na
# hora do pagamento.
MOTOBOY_STATUS_INICIAL=pending
# Endereço de coleta: onde o entregador busca o pacote. A criação do pedido
# exige coordenada; sem LAT/LNG, o CEP é geocodificado a cada chamada.
MOTOBOY_COLETA_CEP=
MOTOBOY_COLETA_ENDERECO=
MOTOBOY_COLETA_LAT=
MOTOBOY_COLETA_LNG=
MOTOBOY_COLETA_NOME=
MOTOBOY_COLETA_TELEFONE=

# Código que a praça manda no header `webhook-security` a cada aviso de entrega.
# Gere um valor aleatório e registre o mesmo em POST /v1/webhooks.
MOTOBOY_WEBHOOK_SECRET=
